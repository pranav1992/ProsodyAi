/.env

# notebook scratch artifacts (regenerated on run, not deliverables)
.ipynb_checkpoints/
backend/notebooks/_synthetic_calls/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env.local

# deploy state (live resource IDs for one specific deployment)
deploy/.state

# OS
.DS_Store

# editors
.vscode/
.idea/
