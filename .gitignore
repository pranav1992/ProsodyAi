# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# backend runtime
backend/storage/
backend/*.db
backend/.env

# root .env (docker-compose secrets: JWT_SECRET, DB password, admin password --
